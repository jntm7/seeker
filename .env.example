# Set to "true" to run in demo mode (mock data, no auth, read-only)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Database (Turso for production on Vercel — uncomment and fill these in)
# DATABASE_URL="libsql://<db>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso-auth-token>"

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_SECRET=
