# Set to "true" to run in demo mode (mock data, no auth, read-only)
DEMO_MODE=false

# Required for self-hosted mode (DEMO_MODE=false)
DATABASE_URL="file:./dev.db"

# The email that receives the first admin invite on initial boot
ADMIN_EMAIL=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_SECRET=
